---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import '@scalar/api-reference/style.css';

export function getStaticPaths() {
  return [
    {
      params: { api: 'identity-access' },
      props: {
        title: 'Identity Access API',
        description: 'OAuth 2.0, OpenID Connect discovery and effective institutional identity.',
        file: 'identity-access.public.v1.yaml',
      },
    },
    {
      params: { api: 'ledger-core' },
      props: {
        title: 'Ledger Core API',
        description: 'Accounts, controlled financial operations, configuration and projections.',
        file: 'ledger-core.public.v1.yaml',
      },
    },
    {
      params: { api: 'workbench' },
      props: {
        title: 'Workbench API',
        description: 'Operational jobs, payment processing status and legacy batch orchestration.',
        file: 'workbench.public.v1.yaml',
      },
    },
  ];
}

const { title, description, file } = Astro.props;
const specUrl = `${import.meta.env.BASE_URL}/openapi/${file}`;
---

<StarlightPage frontmatter={{ title, description, template: 'splash', pagefind: false }} hasSidebar={false}>
  <div class="api-shell">
    <div id="api-reference" data-spec-url={specUrl}></div>
  </div>
</StarlightPage>

<script>
  import { createApiReference } from '@scalar/api-reference';

  const target = document.querySelector<HTMLElement>('#api-reference');
  const url = target?.dataset.specUrl;
  if (target && url) {
    createApiReference(target, {
      url,
      theme: 'default',
      layout: 'modern',
      hideClientButton: true,
      hideTestRequestButton: true,
      hideModels: false,
      hideDarkModeToggle: true,
      showDeveloperTools: 'never',
      persistAuth: false,
      agent: { disabled: true },
      defaultHttpClient: { targetKey: 'shell', clientKey: 'curl' },
      telemetry: false,
      customCss: ':root { --scalar-radius: 4px; --scalar-font: Inter, ui-sans-serif, system-ui, sans-serif; }',
    });
  }
</script>
