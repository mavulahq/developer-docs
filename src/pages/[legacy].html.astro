---
export function getStaticPaths() {
  return [
    { params: { legacy: 'identity-access' }, props: { destination: '/developer-docs/v1/api/identity-access/' } },
    { params: { legacy: 'ledger-core' }, props: { destination: '/developer-docs/v1/api/ledger-core/' } },
    { params: { legacy: 'workbench' }, props: { destination: '/developer-docs/v1/api/workbench/' } },
  ];
}

return Astro.redirect(Astro.props.destination, 301);
---
